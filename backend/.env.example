# =============================================================================
# Live product — same names as test-gravity/.env.example (+ TG config defaults)
# Copy values from your TG .env; Beacon will work once these are filled.
# =============================================================================
BASE_URL=http://localhost:8000
SECRET_KEY=your_super_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 (GCP Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/google.callback

# GCS
GCS_BUCKET_NAME=your_bucket_name
GCS_KEY_JSON=your_json

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://plugai.ripplica.com
INSTAGRAM_REDIRECT_URI=http://localhost:8000/social.instagram.callback
FACEBOOK_REDIRECT_URI=http://localhost:8000/social.facebook.callback

MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=beacon

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_REASONING_EFFORT=medium
OPENAI_LOG_PATH=log.txt
OPENAI_MODEL=gpt-6.1-sol
SCRAPE_LOG_PATH=scrape_log.txt

# DataForSEO — Google Trends Explore
DATAFORSEO_LOGIN=your_dataforseo_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password
TRENDS_GEO=IN
TRENDS_LOCATION_NAME=India
TRENDS_TTL_DAYS=7

OPENAI_CONTENT_PLAN_MODEL=gpt-6.1-sol
OPENAI_CONTENT_PLAN_MAP_EFFORT=low

YT_METADATA_MODEL=gpt-6.1-sol
YT_METADATA_EFFORT=medium

# Optional TG config defaults (used if unset)
# OPENAI_IMAGE_MODEL=gpt-image-2
# THUMBNAIL_MODEL=gpt-image-2
# INSTAGRAM_GRAPH_VERSION=v24.0
# INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
# FACEBOOK_OAUTH_SCOPES=pages_manage_posts,pages_read_engagement,pages_show_list
# PLUG_INSTA_REDIRECT_URI=http://localhost:8000/social.instagram.callback

# =============================================================================
# Beacon migration only — not required for app runtime once data exists
# =============================================================================
TG_MONGODB_URI=mongodb+srv://USER:PASSWORD@TG_HOST/
TG_MONGODB_DB_NAME=youtube_analytics

# CMS_NEW → Beacon website (collections/entries/media). Optional if
# `CMS_NEW copy/.env` exists with MONGO_URL / MONGO_DB_NAME.
# CMS_MONGO_URL=mongodb+srv://USER:PASSWORD@CMS_HOST/
# CMS_MONGO_DB_NAME=cms_platform

BEACON_SUPERUSER_EMAIL=admin@beacon.example.com
BEACON_SUPERUSER_PASSWORD=change-me
BEACON_SUPERUSER_NAME=Beacon Admin
